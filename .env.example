# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=oaas

# WHO ICD-11 API Credentials
WHO_CLIENT_ID=your_client_id_here
WHO_CLIENT_SECRET=your_client_secret_here
WHO_AUTH_URL=https://icdaccessmanagement.who.int/connect/token
WHO_API_BASE_URL=https://id.who.int/icd

# ICD-11 Specific Parameters
ICD11_LINEARIZATION=mms
ICD11_RELEASE_ID=2026-01
ICD11_LANGUAGE=en

# Rate Limiting & Execution Settings
MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_DELAY=0.2

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
OUTPUT_DIR=output
